{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapticradio.com/schemas/research-result-summary.schema.json",
  "title": "Synaptic Radio research result summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "report_id",
    "result",
    "evidence_level",
    "run_manifests",
    "primary_metrics",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "module_id": { "type": "string", "pattern": "^module-[0-9]{2}-[a-z0-9-]+$" },
    "report_id": { "type": "string", "pattern": "^report-[0-9]{2}[a-z]?-[a-z0-9-]+$" },
    "result": { "enum": ["positive", "negative", "mixed", "inconclusive"] },
    "evidence_level": { "enum": ["derived", "implemented", "validated", "scaled", "transferred"] },
    "run_manifests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "primary_metrics": { "type": "object", "minProperties": 1 },
    "uncertainty": { "type": "object" },
    "failed_runs": { "type": "array", "items": { "type": "string" } },
    "retained_examples": { "type": "array", "items": { "type": "string" } },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "unearned_evidence": { "type": "array", "items": { "type": "string" } }
  }
}
