{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapticradio.com/schemas/research-run-manifest.schema.json",
  "title": "Synaptic Radio research run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "run_id",
    "started_at",
    "finished_at",
    "code",
    "configuration",
    "data",
    "randomness",
    "environment",
    "compute",
    "metrics",
    "outputs"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "module_id": { "type": "string", "pattern": "^module-[0-9]{2}-[a-z0-9-]+$" },
    "report_id": { "type": "string", "pattern": "^report-[0-9]{2}[a-z]?-[a-z0-9-]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "failed", "interrupted", "excluded"] },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dirty"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "minLength": 7 },
        "preregistration_commit": { "type": "string", "minLength": 7 },
        "dirty": { "type": "boolean" }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "data": {
      "type": "object",
      "required": ["manifest", "sha256"],
      "properties": {
        "manifest": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "tokenizer_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_parent": { "type": ["string", "null"] }
      }
    },
    "randomness": {
      "type": "object",
      "required": ["seeds"],
      "properties": {
        "seeds": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
        "deterministic_algorithms": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "framework", "hardware", "software_manifest"],
      "properties": {
        "python": { "type": "string" },
        "framework": { "type": "string" },
        "hardware": { "type": "string" },
        "software_manifest": { "type": "string" }
      }
    },
    "compute": {
      "type": "object",
      "required": ["tokens", "wall_time_seconds", "gpu_hours", "failed_gpu_hours", "peak_memory_bytes"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "wall_time_seconds": { "type": "number", "minimum": 0 },
        "gpu_hours": { "type": "number", "minimum": 0 },
        "failed_gpu_hours": { "type": "number", "minimum": 0 },
        "peak_memory_bytes": { "type": "integer", "minimum": 0 },
        "approximate_cost_usd": { "type": "number", "minimum": 0 },
        "emissions_kg_co2e": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "integer", "string", "boolean", "null"] }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "media_type": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
